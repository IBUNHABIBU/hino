<header class="header-container" data-controller="humburger">
  <div class="logo-menu">
    <%= image_tag "logo.ico", alt: "Logo", width: "100", height: "100" %>
    
    <button data-action="click->humburger#toggle" class="btn-mobile-nav">
        <i class="fa-solid fa-bars"></i>
        <i class="fa-solid fa-xmark"></i>
    </button>
  </div>
  
  <div class="header">
    <div class="header__top">
      <div class="header__contacts">
        <% contact_info.each do |contact| %>
          <span>
            <i class="fa-solid <%= contact[:icon] %>"></i> <%= contact[:text] %>
          </span>
        <% end %>
      </div>
      
      <div class="menu-container">
        <div class="social">
          <% social_links.each do |social| %>
            <a href="<%= social[:url] %>" target="_blank" aria-label="<%= social[:platform] %>">
              <i class="fa-brands <%= social[:icon] %>"></i>
            </a>
          <% end %>
        </div>
      </div>
    </div>
    
    <nav>
      <ul class="header__menu" data-action="click->humburger#removenav">
        <% nav_menu_items.each do |item| %>
          <li class="<%= 'mega' if item[:mega] %>">
            <%= link_to item[:name], 
                        send(item[:path]), 
                        class: "header__menu__item #{active_class?(item[:controller])}" %>
          </li>
        <% end %>
        
        <% if current_user %>
          <div class="user-actions">
            <% dashboard_links.each do |link| %>
              <% if link[:method] %>
                <%= button_to link[:name], 
                              send(link[:path]), 
                              method: link[:method], 
                              class: link[:class] %>
              <% else %>
                <%= link_to link[:name], 
                            send(link[:path]), 
                            class: link[:class] %>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </ul>
    </nav>
  </div>
</header>