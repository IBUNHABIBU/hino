<header class="header-container"  data-controller="humburger">
  <div class="logo-menu">
    <%= image_tag "logo.ico", alt: "Logo", width: "100", height: "100" %>
    
    <button data-action="click->humburger#toggle" class="btn-mobile-nav">
        <i class="fa-solid fa-bars"></i>
        <i class="fa-solid fa-xmark"></i>
    </button>
  </div>
  
  <div class="header">

      <div class="header__top">
        <div class="header__contacts" %>
            <span>
            <i class="fa-solid fa-location-dot"></i>  Sido Shinyanga, Tabora Road,
      Ibinzamata Area, Plot no. 2, Block Y
      
            </span>
            <span>
            <i class="fa-solid fa-envelope"></i>
             directors@ecohygiene.co.tz
            </span>
            <span>
            <i class="fa-solid fa-phone-volume"></i>
            0685325766
            </span>
        </div>
        <div class="menu-container">
            
            <div class="social">
              <a href="https://twitter.com" target="_blank"><i class="fa-brands fa-facebook"></i></a>
              <a href="https://twitter.com" target="_blank"><i class="fa-brands fa-twitter"></i></a>
            </div>
        </div>
      </div>
       <nav>
          <ul class="header__menu"  data-action="click->humburger#removenav">
              <li>
                <%= link_to 'Home', root_path, class: "header__menu__item" %>
              </li>
  
              <li class="mega">
                <%= link_to 'Service', ourservices_path, class: "header__menu__item" %>
              </li>
              <li class="mega">
                <%= link_to 'Company', about_us_path, class: "header__menu__item" %>
              </li>
              <li>
                <%= link_to 'Contact Us', contact_us_path, class: "header__menu__item" %>
              </li>
            <% if current_user %>
              <%= link_to 'Dashboard', nyaki_path, class: "btn--dash" %>
              <%= button_to 'logout', logout_path, method: :delete, class: "btn--dash" %>
              <% end %>
            </ul>
       </nav>
  </div>
</header>